<Window x:Class="PcOrg.App.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:PcOrg.App.Infrastructure"
        Title="Etichette e nota" Icon="pack://application:,,,/GestioneFile;component/Assets/pcorg.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,20,24,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="40" Height="40" CornerRadius="20" Background="#CA8A04" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Tag}" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Etichette e nota" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="Subtitle" Style="{StaticResource Secondary}" MaxWidth="440" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Etichette (separate da virgola)" Margin="0,0,0,4" />
            <TextBox x:Name="TagsBox" Padding="6,4" ToolTip="Es. ufficio, stampante, da tenere" />
            <WrapPanel x:Name="KnownTags" Margin="0,8,0,0" />

            <TextBlock Text="Nota" Margin="0,12,0,4" />
            <TextBox x:Name="NoteBox" Padding="6,4" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"
                     VerticalScrollBarVisibility="Auto" />
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Etichette e note si trovano con la ricerca normale, seguono il file quando lo sposti con Gestione File e restano anche se ricostruisci l'indice. Lascia vuoti i campi per toglierle." />
        </StackPanel>
        <Border Grid.Row="1" Padding="24,14" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Salva" MinWidth="110" IsDefault="True" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="Annulla" MinWidth="110" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
