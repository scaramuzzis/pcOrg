<Window x:Class="PcOrg.App.Views.MoveHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcOrg.App.ViewModels"
        xmlns:inf="clr-namespace:PcOrg.App.Infrastructure"
        xmlns:c="clr-namespace:PcOrg.App.Controls"
        Title="Cronologia spostamenti" Icon="/Assets/pcorg.ico" Width="940" Height="620" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="22" Background="#7C3AED" VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.History}" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Cronologia spostamenti" FontSize="18" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Seleziona uno spostamento per vedere i file coinvolti. Puoi riportarli dov'erano in qualsiasi momento." />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="BatchGrid" Grid.Row="1" Margin="24,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="32"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionChanged="BatchGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Width="150"
                                    Binding="{Binding CreatedUtc, StringFormat=g, Converter={x:Static vm:UtcToLocalConverter.Instance}}" />
                <DataGridTextColumn Header="Descrizione" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="File" Binding="{Binding ItemCount}" Width="60" />
                <DataGridTemplateColumn Header="Stato" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="State" Text="Eseguito" VerticalAlignment="Center" Foreground="#16A34A" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Undone}" Value="True">
                                    <Setter TargetName="State" Property="Text" Value="Annullato" />
                                    <Setter TargetName="State" Property="Foreground" Value="#94A3B8" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="FILE DELLO SPOSTAMENTO SELEZIONATO" Style="{StaticResource SectionHeader}" Margin="26,14,0,6" />

        <DataGrid x:Name="EntryGrid" Grid.Row="3" Margin="24,0" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30"
                  HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Da" Binding="{Binding FromPath}" Width="*" />
                <DataGridTextColumn Header="A" Binding="{Binding ToPath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Margin="0,16,0,0" Padding="24,14" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <c:IconButton x:Name="UndoButton" Glyph="{x:Static inf:Glyphs.Undo}" Label="Riporta i file dov'erano" IsEnabled="False"
                              Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" Click="Undo_Click" />
                <Button Content="Chiudi" IsCancel="True" MinWidth="110" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
