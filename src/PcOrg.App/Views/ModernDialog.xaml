<Window x:Class="PcOrg.App.Views.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,24,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBadge" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="24,14" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrimaryButton" MinWidth="110" IsDefault="True" Margin="0,0,8,0"
                        Style="{DynamicResource AccentButtonStyle}" Click="Primary_Click" />
                <Button x:Name="SecondaryButton" MinWidth="110" IsCancel="True" Click="Secondary_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
