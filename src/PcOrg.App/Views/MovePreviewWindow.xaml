<Window x:Class="PcOrg.App.Views.MovePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:PcOrg.App.Infrastructure"
        xmlns:c="clr-namespace:PcOrg.App.Controls"
        Title="Anteprima spostamento" Icon="pack://application:,,,/PcOrg;component/Assets/pcorg.ico" Width="940" Height="560" MinWidth="620" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Intestazione -->
        <Grid Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="22" Background="#2563EB" VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Move}" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Controlla prima di spostare" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="PlanGrid" Grid.Row="1" Margin="24,0" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="32"
                  HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Stato" Width="200" MinWidth="200" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="14" Margin="2,0,8,0"
                                           Text="{x:Static inf:Glyphs.Success}" Foreground="#16A34A" />
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Rinominato">
                                    <Setter TargetName="StatusIcon" Property="Text" Value="{x:Static inf:Glyphs.Info}" />
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#2563EB" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="GiaPresente">
                                    <Setter TargetName="StatusIcon" Property="Text" Value="{x:Static inf:Glyphs.Cancel}" />
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#94A3B8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="NonTrovato">
                                    <Setter TargetName="StatusIcon" Property="Text" Value="{x:Static inf:Glyphs.Warning}" />
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#D97706" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Da" Binding="{Binding Source}" Width="*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="A" Binding="{Binding Destination}" Width="*" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Piede con opzioni e pulsanti -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="24,14" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:IconButton x:Name="ConfirmButton" Glyph="{x:Static inf:Glyphs.Move}" Label="Sposta" IsDefault="True" MinWidth="120" Margin="0,0,8,0"
                                  Style="{DynamicResource AccentButtonStyle}" Click="Confirm_Click" />
                    <Button Content="Annulla" IsCancel="True" MinWidth="110" />
                </StackPanel>
                <CheckBox x:Name="AddToMonitored" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="Così i file spostati restano nell'elenco e si possono cercare">
                    <TextBlock TextWrapping="Wrap" Text="La cartella di destinazione non è monitorata: aggiungila, così i file restano cercabili" />
                </CheckBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
