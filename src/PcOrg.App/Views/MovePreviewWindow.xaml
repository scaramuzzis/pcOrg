<Window x:Class="PcOrg.App.Views.MovePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anteprima spostamento" Width="900" Height="520" MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="14" />

        <DataGrid x:Name="PlanGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stato" Binding="{Binding StatusText}" Width="170" />
                <DataGridTextColumn Header="Da" Binding="{Binding Source}" Width="*" />
                <DataGridTextColumn Header="A" Binding="{Binding Destination}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <CheckBox x:Name="AddToMonitored" Grid.Row="2" Margin="0,10,0,0" IsChecked="True"
                  Content="La cartella di destinazione non è monitorata: aggiungila, così i file restano cercabili" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" Content="Sposta" IsDefault="True" MinWidth="100" Margin="0,0,8,0"
                    Click="Confirm_Click" />
            <Button Content="Annulla" IsCancel="True" MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
