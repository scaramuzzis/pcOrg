<Window x:Class="PcOrg.App.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:PcOrg.App.Infrastructure"
        xmlns:c="clr-namespace:PcOrg.App.Controls"
        Title="Regola di archiviazione" Icon="pack://application:,,,/GestioneFile;component/Assets/pcorg.ico"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,20,24,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="40" Height="40" CornerRadius="20" Background="#0D9488" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Rules}" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Regola di archiviazione" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="I file che rispondono a tutte le condizioni indicate vanno nella cartella di destinazione" Style="{StaticResource Secondary}" />
                </StackPanel>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" x:Key="Label">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,6,12,6" />
                    </Style>
                </Grid.Resources>

                <TextBlock Style="{StaticResource Label}" Text="Nome della regola" />
                <TextBox x:Name="RuleName" Grid.Column="1" Margin="0,4" Padding="6,4" />

                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Categoria" />
                <ComboBox x:Name="CategoryChooser" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Produttore contiene" />
                <TextBox x:Name="Company" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="6,4" ToolTip="Es. NVIDIA, Realtek, Microsoft. Vuoto = qualsiasi produttore" />

                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Nome del file contiene" />
                <TextBox x:Name="NameContains" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="6,4" ToolTip="Es. driver, setup, fattura. Vuoto = qualsiasi nome" />

                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Cartella di destinazione" />
                <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
                    <c:IconButton DockPanel.Dock="Right" Glyph="{x:Static inf:Glyphs.FolderOpen}" Label="Sfoglia…" Margin="8,0,0,0" Click="Browse_Click" />
                    <TextBox x:Name="Destination" Padding="6,4" TextChanged="Destination_TextChanged" />
                </DockPanel>

                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Segnaposto (clic per inserirli): diventano il valore del file, es. D:\Archivio\Driver\{Produttore} → D:\Archivio\Driver\NVIDIA" />
                <WrapPanel x:Name="PlaceholderButtons" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
            </Grid>

            <CheckBox x:Name="EnabledBox" Content="Regola attiva" Margin="170,4,0,0" />
            <TextBlock x:Name="ExampleText" Margin="170,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="24,14" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Salva la regola" MinWidth="130" IsDefault="True" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="Annulla" MinWidth="110" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
