<Window x:Class="PcOrg.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcOrg.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="pcOrg — i tuoi file in ordine"
        Width="1200" Height="760" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static vm:FocusCommands.FocusSearch}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pannello sinistro: cartelle monitorate e categorie -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Cartelle monitorate" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel ToolTip="{Binding Path}">
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Opacity="0.7"
                                       Text="{Binding LastScanUtc, Converter={x:Static vm:UtcToLocalConverter.Instance}, StringFormat='Ultima scansione: {0:g}', TargetNullValue='Mai scansionata'}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                <Button Content="Aggiungi…" Command="{Binding AddRootCommand}" Margin="0,0,6,6" />
                <Button Content="Rimuovi" Command="{Binding RemoveRootCommand}" Margin="0,0,6,6" />
                <Button Content="Aggiorna (F5)" Command="{Binding ScanCommand}" Margin="0,0,6,6" />
            </WrapPanel>

            <TextBlock Grid.Row="3" Text="Categorie" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,6" />
            <ListBox Grid.Row="4" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" Opacity="0.7" Margin="8,0,0,0">
                                <Run Text="{Binding Count, StringFormat=N0, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding TotalSize, Converter={StaticResource FileSize}, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

        <!-- Pannello destro: ricerca, azioni, risultati -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" FontSize="16" Padding="6"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Scrivi parte del nome o della cartella (Ctrl+F)" />
            <TextBlock IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.5" FontSize="16"
                       Text="Cerca per nome o cartella… (es. nvidia 566, setup x64)">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                <Button Content="Apri" Command="{Binding OpenFileCommand}" Margin="0,0,6,0" />
                <Button Content="Apri cartella" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0" />
                <Button Content="Copia percorso" Command="{Binding CopyPathCommand}" Margin="0,0,6,0" />
                <Button Content="Sposta in…" Command="{Binding MoveSelectedCommand}" Margin="0,0,6,0" FontWeight="SemiBold" />
                <Button Content="Cronologia spostamenti" Command="{Binding ShowHistoryCommand}" Margin="0,0,6,0" />
            </WrapPanel>

            <DataGrid x:Name="ResultsGrid" Grid.Row="2" ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="ResultsGrid_SelectionChanged" MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Apri" Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="Apri cartella" Command="{Binding OpenFolderCommand}" />
                        <MenuItem Header="Copia percorso" Command="{Binding CopyPathCommand}" />
                        <Separator />
                        <MenuItem Header="Sposta in…" Command="{Binding MoveSelectedCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" SortMemberPath="Category" Width="110" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Extension}" Width="70" />
                    <DataGridTextColumn Header="Dimensione" Binding="{Binding Size, Converter={StaticResource FileSize}}" Width="95"
                                        SortMemberPath="Size">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Modificato" Binding="{Binding ModifiedUtc, StringFormat=g, Converter={x:Static vm:UtcToLocalConverter.Instance}}"
                                        Width="130" SortMemberPath="ModifiedUtc" />
                    <DataGridTextColumn Header="Cartella" Binding="{Binding Folder}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Barra di stato -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Interrompi" Command="{Binding CancelScanCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" Margin="8,0" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
