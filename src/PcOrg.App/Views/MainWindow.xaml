<Window x:Class="PcOrg.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcOrg.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="pcOrg — i tuoi file in ordine"
        Width="1200" Height="760" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static vm:FocusCommands.FocusSearch}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pannello sinistro: cartelle monitorate e categorie -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Cartelle monitorate" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel ToolTip="{Binding Path}">
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Opacity="0.7"
                                       Text="{Binding LastScanUtc, Converter={x:Static vm:UtcToLocalConverter.Instance}, StringFormat='Ultima scansione: {0:g}', TargetNullValue='Mai scansionata'}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                <Button Content="Aggiungi…" Command="{Binding AddRootCommand}" Margin="0,0,6,6" />
                <Button Content="Rimuovi" Command="{Binding RemoveRootCommand}" Margin="0,0,6,6" />
                <Button Content="Aggiorna (F5)" Command="{Binding ScanCommand}" Margin="0,0,6,6" />
            </WrapPanel>

            <TextBlock Grid.Row="3" Text="Categorie" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,6" />
            <ListBox Grid.Row="4" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <!-- Le sottocategorie sono rientrate sotto la categoria principale -->
                                        <DataTrigger Binding="{Binding IsSubcategory}" Value="True">
                                            <Setter Property="Margin" Value="18,0,0,0" />
                                            <Setter Property="TextElement.FontSize" Value="12" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Opacity="0.7" Margin="8,0,0,0">
                                <Run Text="{Binding Count, StringFormat=N0, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding TotalSize, Converter={StaticResource FileSize}, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

        <!-- Pannello destro: ricerca e schede File / Prodotti -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" FontSize="16" Padding="6"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Scrivi parte del nome, della cartella, del prodotto o del produttore (Ctrl+F)" />
            <TextBlock IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.5" FontSize="16"
                       Text="Cerca per nome, cartella, prodotto o produttore… (es. nvidia 566, setup x64)">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TabControl x:Name="Tabs" x:FieldModifier="public" Grid.Row="1" Margin="0,8,0,0">
                <!-- Scheda File -->
                <TabItem Header="File">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Apri" Command="{Binding OpenFileCommand}" Margin="0,0,6,0" />
                            <Button Content="Apri cartella" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0" />
                            <Button Content="Copia percorso" Command="{Binding CopyPathCommand}" Margin="0,0,6,0" />
                            <Button Content="Sposta in…" Command="{Binding MoveSelectedCommand}" Margin="0,0,6,0" FontWeight="SemiBold" />
                            <Button Content="Cronologia spostamenti" Command="{Binding ShowHistoryCommand}" Margin="0,0,6,0" />
                        </WrapPanel>

                        <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionChanged="FileGrid_SelectionChanged" MouseDoubleClick="FileGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Apri" Command="{Binding OpenFileCommand}" />
                                    <MenuItem Header="Apri cartella" Command="{Binding OpenFolderCommand}" />
                                    <MenuItem Header="Copia percorso" Command="{Binding CopyPathCommand}" />
                                    <Separator />
                                    <MenuItem Header="Sposta in…" Command="{Binding MoveSelectedCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" SortMemberPath="Category" Width="105" />
                                <DataGridTextColumn Header="Versione" Binding="{Binding Version}" Width="95" />
                                <DataGridTextColumn Header="Produttore" Binding="{Binding Company}" Width="*" />
                                <DataGridTextColumn Header="Dimensione" Binding="{Binding Size, Converter={StaticResource FileSize}}" Width="90"
                                                    SortMemberPath="Size">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Modificato" Binding="{Binding ModifiedUtc, StringFormat=g, Converter={x:Static vm:UtcToLocalConverter.Instance}}"
                                                    Width="125" SortMemberPath="ModifiedUtc" />
                                <DataGridTextColumn Header="Cartella" Binding="{Binding Folder}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Dettagli del file selezionato -->
                        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10" BorderThickness="1" CornerRadius="4"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                Visibility="{Binding SelectedFile, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                            <Grid DataContext="{Binding SelectedFile}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,1,12,1" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </Grid.Resources>

                                <TextBlock Grid.ColumnSpan="4" FontWeight="SemiBold" Text="{Binding Path}" ToolTip="{Binding Path}" />

                                <TextBlock Grid.Row="1" Opacity="0.7" Text="Prodotto" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Meta.ProductName}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Opacity="0.7" Text="Descrizione" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Meta.FileDescription}" />

                                <TextBlock Grid.Row="2" Opacity="0.7" Text="Produttore" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Meta.CompanyName}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Opacity="0.7" Text="Versione" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Meta.VersionDetails}" />

                                <TextBlock Grid.Row="3" Opacity="0.7" Text="Firma digitale" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SignatureText}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Opacity="0.7" Text="Architettura" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding ArchitectureText}" />

                                <TextBlock Grid.Row="4" Opacity="0.7" Text="Tipo di installer" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Meta.InstallerType}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Opacity="0.7" Text="Nome originale" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Meta.OriginalFilename}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Scheda Prodotti -->
                <TabItem Header="Prodotti e versioni">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,8">
                            <CheckBox DockPanel.Dock="Right" Content="Solo prodotti con più file" VerticalAlignment="Center"
                                      IsChecked="{Binding OnlyMultipleVersions}" />
                            <TextBlock Text="{Binding ProductsSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ProductsView}" SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Prodotto" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Produttore" Binding="{Binding Company}" Width="*" />
                                <DataGridTextColumn Header="Ultima versione" Binding="{Binding LatestVersion}" Width="110" />
                                <DataGridTextColumn Header="Versioni" Binding="{Binding VersionCount}" Width="70" />
                                <DataGridTextColumn Header="File" Binding="{Binding Files.Count}" Width="50" />
                                <DataGridTextColumn Header="Spazio" Binding="{Binding TotalSize, Converter={StaticResource FileSize}}"
                                                    SortMemberPath="TotalSize" Width="85" />
                                <DataGridTextColumn Header="Versioni vecchie" Binding="{Binding OldVersionsSize, Converter={StaticResource FileSize}}"
                                                    SortMemberPath="OldVersionsSize" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,8">
                            <TextBlock Text="File del prodotto selezionato" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="Seleziona le versioni vecchie" Click="SelectOldVersions_Click" Margin="0,0,6,0" />
                            <Button Content="Sposta in…" Command="{Binding MoveSelectedCommand}" Margin="0,0,6,0" FontWeight="SemiBold" />
                            <Button Content="Apri cartella" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0" />
                        </WrapPanel>

                        <DataGrid x:Name="ProductFilesGrid" Grid.Row="3" ItemsSource="{Binding ProductFiles}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  SelectionChanged="ProductFilesGrid_SelectionChanged" MouseDoubleClick="FileGrid_MouseDoubleClick">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOld}" Value="True">
                                            <Setter Property="Opacity" Value="0.65" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Versione" Binding="{Binding File.Version}" Width="110" />
                                <DataGridTextColumn Header="Stato" Binding="{Binding State}" Width="120" />
                                <DataGridTextColumn Header="Nome" Binding="{Binding File.Name}" Width="2*" />
                                <DataGridTextColumn Header="Architettura" Binding="{Binding File.ArchitectureText}" Width="110" />
                                <DataGridTextColumn Header="Firma" Binding="{Binding File.SignatureText}" Width="*" />
                                <DataGridTextColumn Header="Dimensione" Binding="{Binding File.Size, Converter={StaticResource FileSize}}" Width="90" />
                                <DataGridTextColumn Header="Cartella" Binding="{Binding File.Folder}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Barra di stato -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Interrompi" Command="{Binding CancelScanCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" Margin="8,0" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
