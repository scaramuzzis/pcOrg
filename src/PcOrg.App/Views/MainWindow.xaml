<Window x:Class="PcOrg.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcOrg.App.ViewModels"
        xmlns:inf="clr-namespace:PcOrg.App.Infrastructure"
        xmlns:c="clr-namespace:PcOrg.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="pcOrg — i tuoi file in ordine"
        Icon="pack://application:,,,/PcOrg;component/Assets/pcorg.ico"
        Width="1320" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="F5" Modifiers="Control" Command="{Binding FullScanCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static vm:FocusCommands.FocusSearch}" />
        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddRootCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding AddNetworkRootCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCsvCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyPathCommand}" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding MoveSelectedCommand}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ShowHistoryCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowTabCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowTabCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowTabCommand}" CommandParameter="2" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static vm:FocusCommands.OpenSettings}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- ============================================================ Barra dei menu -->
        <Menu x:Name="MainMenu" x:FieldModifier="public" DockPanel.Dock="Top" Padding="8,2" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="Aggiungi _cartella…" Command="{Binding AddRootCommand}" InputGestureText="Ctrl+O">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Add}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Aggiungi cartella di _rete…" Command="{Binding AddNetworkRootCommand}" InputGestureText="Ctrl+Maiusc+O">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.NetworkFolder}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rimuovi la cartella selezionata" Command="{Binding RemoveRootCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Delete}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Aggiorna (rapido)" Command="{Binding ScanCommand}" InputGestureText="F5">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Refresh}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Scansione completa" Command="{Binding FullScanCommand}" InputGestureText="Ctrl+F5">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Database}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Esporta l'elenco in Excel (CSV)…" Command="{Binding ExportCsvCommand}" InputGestureText="Ctrl+E">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Export}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Esci" InputGestureText="Alt+F4" Click="Exit_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Exit}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Modifica">
                <MenuItem Header="_Apri" Command="{Binding OpenFileCommand}" InputGestureText="Invio">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Open}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Mostra nella _cartella" Command="{Binding OpenFolderCommand}" InputGestureText="Ctrl+Maiusc+E">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.FolderOpen}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Copia percorso" Command="{Binding CopyPathCommand}" InputGestureText="Ctrl+Maiusc+C">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Copy}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Seleziona _tutto" InputGestureText="Ctrl+A" Click="SelectAll_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.SelectAll}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Sposta in…" Command="{Binding MoveSelectedCommand}" InputGestureText="Ctrl+M">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Move}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Sposta nel Ce_stino…" Command="{Binding RecycleSelectedCommand}" InputGestureText="Canc">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Delete}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Cerca" Command="{x:Static vm:FocusCommands.FocusSearch}" InputGestureText="Ctrl+F">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Search}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Cancella la ricerca" Command="{Binding ClearSearchCommand}" InputGestureText="Esc">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Cancel}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Visualizza">
                <MenuItem Header="_File" Command="{Binding ShowTabCommand}" CommandParameter="0" InputGestureText="Ctrl+1">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Folder}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Prodotti e versioni" Command="{Binding ShowTabCommand}" CommandParameter="1" InputGestureText="Ctrl+2">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Package}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="C_loni e pulizia" Command="{Binding ShowTabCommand}" CommandParameter="2" InputGestureText="Ctrl+3">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Duplicate}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Colonne dell'elenco…" Click="ColumnsSettings_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Columns}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pannello _anteprima immagini" IsCheckable="True" IsChecked="{Binding ShowPreviewPanel}" />
                <MenuItem Header="Pannello _dettagli del file" IsCheckable="True" IsChecked="{Binding ShowDetailsPanel}" />
                <Separator />
                <MenuItem Header="_Tema">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Theme}" /></MenuItem.Icon>
                    <MenuItem Header="Come _Windows" IsCheckable="True" IsChecked="{Binding IsThemeSystem, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="Sistema" />
                    <MenuItem Header="_Chiaro" IsCheckable="True" IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="Chiaro" />
                    <MenuItem Header="_Scuro" IsCheckable="True" IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="Scuro" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Strumenti">
                <MenuItem Header="Cerca i c_loni" Command="{Binding FindDuplicatesCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Duplicate}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Cronologia spostamenti…" Command="{Binding ShowHistoryCommand}" InputGestureText="Ctrl+H">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.History}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Interrompi la scansione" Command="{Binding CancelScanCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Cancel}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Apri la cartella dei _dati" Command="{Binding OpenDataFolderCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.FolderOpen}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Apri il _registro attività" Command="{Binding OpenLogCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Log}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Impostazioni…" Command="{x:Static vm:FocusCommands.OpenSettings}" InputGestureText="Ctrl+,">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Settings}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_?">
                <MenuItem Header="_Guida di pcOrg" Command="{Binding ShowHelpCommand}" InputGestureText="F1">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Help}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Scorciatoie da tastiera" Command="{Binding ShowHelpCommand}" CommandParameter="scorciatoie">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Keyboard}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Consigli per organizzare al meglio" Command="{Binding ShowHelpCommand}" CommandParameter="Consigli">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Lightbulb}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Domande frequenti" Command="{Binding ShowHelpCommand}" CommandParameter="Domande">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Question}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Informazioni su pcOrg" Command="{Binding ShowAboutCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Info}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ Intestazione -->
        <Border Padding="18,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/PcOrg;component/Assets/pcorg.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="pcOrg" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="I tuoi file in ordine" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Ricerca -->
                <Grid Grid.Column="1" MaxWidth="680" Margin="16,0">
                    <TextBox x:Name="SearchBox" FontSize="15" Padding="38,8,36,8" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Cerca per nome, cartella, prodotto o produttore. Ctrl+F per cercare, Esc per cancellare." />
                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Search}" Margin="13,0,0,0"
                               HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0.7" />
                    <TextBlock IsHitTestVisible="False" Margin="39,0,0,0" VerticalAlignment="Center" FontSize="15"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Cerca file, programmi, driver, produttori…   (es. nvidia 566, setup x64)">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <c:IconButton Glyph="{x:Static inf:Glyphs.Cancel}" Style="{StaticResource SubtleIconButton}"
                                  HorizontalAlignment="Right" Margin="0,0,4,0" Command="{Binding ClearSearchCommand}"
                                  ToolTip="Cancella la ricerca (Esc)"
                                  Visibility="{Binding Text, ElementName=SearchBox, Converter={x:Static inf:EmptyToCollapsedConverter.Instance}}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:IconButton Glyph="{x:Static inf:Glyphs.Refresh}" Label="Aggiorna" Command="{Binding ScanCommand}" Margin="0,0,8,0"
                                  ToolTip="Aggiornamento rapido: rilegge solo le cartelle in cui qualcosa è cambiato (F5). Scansione completa: Ctrl+F5" />
                    <c:IconButton Glyph="{x:Static inf:Glyphs.History}" Label="Cronologia" Command="{Binding ShowHistoryCommand}"
                                  ToolTip="Vedi gli spostamenti fatti e annullali" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra di avanzamento sottile durante scansione e lettura metadati -->
        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- ============================================================ Contenuto -->
        <Grid x:Name="ContentGrid" Grid.Row="2" Margin="14,12,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="230" MaxWidth="600" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pannello sinistro: cartelle e categorie -->
            <Border Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MaxHeight="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="4,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <c:IconButton Glyph="{x:Static inf:Glyphs.Add}" Style="{StaticResource SubtleIconButton}"
                                          Command="{Binding AddRootCommand}" ToolTip="Aggiungi una cartella da tenere in ordine" />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.NetworkFolder}" Style="{StaticResource SubtleIconButton}"
                                          Command="{Binding AddNetworkRootCommand}"
                                          ToolTip="Aggiungi una cartella di rete (NAS o altro computer), es. \\NAS\Foto" />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.Delete}" Style="{StaticResource SubtleIconButton}"
                                          Command="{Binding RemoveRootCommand}"
                                          ToolTip="Smetti di monitorare la cartella selezionata (i file non vengono toccati)" />
                        </StackPanel>
                        <TextBlock Text="CARTELLE MONITORATE" Style="{StaticResource SectionHeader}" />
                    </DockPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}" ItemContainerStyle="{StaticResource CompactItem}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Path}" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RootIcon" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18"
                                               Foreground="#E3A008" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Path, Converter={x:Static inf:FolderNameConverter.Instance}}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Secondary}" />
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="11"
                                                   Text="{Binding LastScanUtc, Converter={x:Static vm:UtcToLocalConverter.Instance}, StringFormat='Aggiornata {0:g}', TargetNullValue='Mai scansionata'}" />
                                        <TextBlock FontSize="11" Foreground="#DC2626" Text="Non raggiungibile: file mostrati dall'ultimo aggiornamento"
                                                   TextWrapping="Wrap" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                        <Setter TargetName="RootIcon" Property="Foreground" Value="#0891B2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                        <Setter TargetName="RootIcon" Property="Foreground" Value="#94A3B8" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="CATEGORIE" Style="{StaticResource SectionHeader}" Margin="4,14,0,6" />

                    <ListBox Grid.Row="3" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" ItemContainerStyle="{StaticResource CompactItem}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <!-- Le sottocategorie sono rientrate sotto la categoria principale -->
                                                <DataTrigger Binding="{Binding IsSubcategory}" Value="True">
                                                    <Setter Property="Margin" Value="22,0,0,0" />
                                                    <Setter Property="TextElement.FontSize" Value="12" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border Width="26" Height="26" CornerRadius="6" Background="{Binding Accent}" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count, StringFormat=N0}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding TotalSize, Converter={StaticResource FileSize}}" HorizontalAlignment="Right"
                                                   Style="{StaticResource Secondary}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Divisore trascinabile: la larghezza del pannello sinistro viene ricordata -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                          ToolTip="Trascina per allargare o restringere il pannello" />

            <!-- Pannello destro: schede File / Prodotti -->
            <TabControl x:Name="Tabs" x:FieldModifier="public" Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex}"
                        Visibility="{Binding HasRoots, Converter={StaticResource BoolToVisibility}}">
                <!-- Scheda File -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Folder}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="File" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Barra comandi -->
                            <WrapPanel Margin="0,0,0,10">
                                <c:IconButton Glyph="{x:Static inf:Glyphs.Open}" Label="Apri" Command="{Binding OpenFileCommand}" Margin="0,0,6,0"
                                              ToolTip="Apri il file con il programma predefinito (doppio clic). Per programmi e installer viene chiesta conferma." />
                                <c:IconButton Glyph="{x:Static inf:Glyphs.FolderOpen}" Label="Mostra nella cartella" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0"
                                              ToolTip="Apri Esplora risorse con il file già selezionato" />
                                <c:IconButton Glyph="{x:Static inf:Glyphs.Copy}" Label="Copia percorso" Command="{Binding CopyPathCommand}" Margin="0,0,6,0"
                                              ToolTip="Copia negli appunti il percorso dei file selezionati" />
                                <c:IconButton Glyph="{x:Static inf:Glyphs.Move}" Label="Sposta in…" Command="{Binding MoveSelectedCommand}" Margin="0,0,6,0"
                                              Style="{DynamicResource AccentButtonStyle}"
                                              ToolTip="Scegli dove spostare i file selezionati: prima vedrai un'anteprima, e potrai sempre annullare" />
                            </WrapPanel>

                            <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}"
                                      inf:GridKeys.DeleteCommand="{Binding RecycleSelectedCommand}"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="34"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      SelectionChanged="FileGrid_SelectionChanged" MouseDoubleClick="FileGrid_MouseDoubleClick"
                                      PreviewKeyDown="FileGrid_PreviewKeyDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Apri" Command="{Binding OpenFileCommand}">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Open}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Mostra nella cartella" Command="{Binding OpenFolderCommand}">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.FolderOpen}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copia percorso" Command="{Binding CopyPathCommand}">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Copy}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Sposta in…" Command="{Binding MoveSelectedCommand}">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Move}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sposta nel Cestino…" Command="{Binding RecycleSelectedCommand}" InputGestureText="Canc">
                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Delete}" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Nome" Width="2*" MinWidth="220" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Icon}" Margin="2,0,10,0"
                                                               Text="{Binding Category, Converter={x:Static inf:CategoryGlyphConverter.Instance}}"
                                                               Foreground="{Binding Category, Converter={x:Static inf:CategoryBrushConverter.Instance}}" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" SortMemberPath="Category" Width="115" MinWidth="86" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Versione" Binding="{Binding Version}" Width="100" MinWidth="75" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Produttore" Binding="{Binding Company}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Dimensione" Binding="{Binding Size, Converter={StaticResource FileSize}}" Width="95" MinWidth="71"
                                                        SortMemberPath="Size">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="4,0" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Modificato" Binding="{Binding ModifiedUtc, StringFormat=g, Converter={x:Static vm:UtcToLocalConverter.Instance}}"
                                                        Width="130" MinWidth="97" SortMemberPath="ModifiedUtc" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Cartella" Binding="{Binding Folder}" Width="2*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                                    <!-- Colonne facoltative: si attivano da Impostazioni → Colonne o col tasto destro sulle intestazioni -->
                                    <DataGridTextColumn Header="Prodotto" Binding="{Binding ProductName}" Width="150" MinWidth="80" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Descrizione" Binding="{Binding Meta.FileDescription}" Width="180" MinWidth="80" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Firma digitale" Binding="{Binding SignatureText}" Width="180" MinWidth="80" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Architettura" Binding="{Binding ArchitectureText}" Width="115" MinWidth="80" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Tipo di installer" Binding="{Binding Meta.InstallerType}" Width="150" MinWidth="80" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Estensione" Binding="{Binding Extension}" Width="85" MinWidth="60" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Percorso completo" Binding="{Binding Path}" Width="320" MinWidth="120" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Dettagli del file selezionato -->
                            <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource Card}"
                                    Visibility="{Binding DetailsPanelVisible, Converter={StaticResource BoolToVisibility}}">
                                <Grid DataContext="{Binding SelectedFile}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,2,12,2" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </Grid.Resources>

                                    <Border Grid.RowSpan="5" Width="48" Height="48" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,14,0"
                                            Background="{Binding Category, Converter={x:Static inf:CategoryBrushConverter.Instance}}">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Foreground="White" HorizontalAlignment="Center" Margin="0"
                                                   Text="{Binding Category, Converter={x:Static inf:CategoryGlyphConverter.Instance}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,4">
                                        <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Name}" Margin="0" />
                                        <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" Style="{StaticResource Secondary}" Margin="0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Secondary}" Text="Prodotto" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Meta.ProductName, TargetNullValue='—'}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Secondary}" Text="Descrizione" />
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Meta.FileDescription, TargetNullValue='—'}" />

                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Secondary}" Text="Produttore" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Meta.CompanyName, TargetNullValue='—'}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Secondary}" Text="Versione" />
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding Meta.VersionDetails, TargetNullValue='—'}" />

                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Secondary}" Text="Firma digitale" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SignatureText, TargetNullValue='—'}" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Secondary}" Text="Architettura" />
                                    <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding ArchitectureText, TargetNullValue='—'}" />

                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Secondary}" Text="Tipo di installer" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Meta.InstallerType, TargetNullValue='—'}" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource Secondary}" Text="Dimensione" />
                                    <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding Size, Converter={StaticResource FileSize}}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Anteprima dell'immagine selezionata -->
                        <Border Grid.Column="1" Width="300" Margin="12,10,0,0" Style="{StaticResource Card}"
                                Visibility="{Binding PreviewPanelVisible, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Photo}" Foreground="#DB2777" Margin="0,0,8,0" />
                                    <TextBlock Text="Anteprima" FontWeight="SemiBold" FontSize="15" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedFile.Name}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedFile.Path}" />
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewInfo}" TextWrapping="Wrap"
                                           Style="{StaticResource Secondary}" Margin="0,8,0,0" />
                                <Border CornerRadius="6" Margin="0,8,0,0" Padding="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" StretchDirection="DownOnly"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           ToolTip="Doppio clic sul file per aprirlo con il visualizzatore di Windows" />
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Scheda Prodotti -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Package}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Prodotti e versioni" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,8">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Content="Solo prodotti con più file" VerticalAlignment="Center"
                                          IsChecked="{Binding OnlyMultipleVersions}"
                                          ToolTip="Mostra solo i programmi di cui hai più copie o più versioni" />
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Info}" Foreground="#2563EB" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding ProductsSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <DataGrid x:Name="ProductsGrid" Grid.Row="1" ItemsSource="{Binding ProductsView}" SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="34"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Prodotto" Width="2*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Package}" Foreground="#2563EB" Margin="2,0,10,0" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Produttore" Binding="{Binding Company}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Ultima versione" Binding="{Binding LatestVersion}" Width="115" MinWidth="86" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Versioni" Binding="{Binding VersionCount}" Width="75" MinWidth="56" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="File" Binding="{Binding Files.Count}" Width="55" MinWidth="55" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Spazio" Binding="{Binding TotalSize, Converter={StaticResource FileSize}}"
                                                    SortMemberPath="TotalSize" Width="90" MinWidth="67" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Versioni vecchie" Binding="{Binding OldVersionsSize, Converter={StaticResource FileSize}}"
                                                    SortMemberPath="OldVersionsSize" Width="120" MinWidth="90" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="2" Margin="0,12,0,10">
                            <TextBlock Text="FILE DEL PRODOTTO SELEZIONATO" Style="{StaticResource SectionHeader}" Margin="2,0,14,0" />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.SelectAll}" Label="Seleziona le versioni vecchie" Click="SelectOldVersions_Click" Margin="0,0,6,0"
                                          ToolTip="Seleziona tutte le versioni precedenti all'ultima, per spostarle in un colpo solo" />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.Move}" Label="Sposta in…" Command="{Binding MoveSelectedCommand}" Margin="0,0,6,0"
                                          Style="{DynamicResource AccentButtonStyle}" ToolTip="Sposta i file selezionati (con anteprima e annullamento)" />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.FolderOpen}" Label="Mostra nella cartella" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0" />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.Delete}" Label="Sposta nel Cestino…" Command="{Binding RecycleSelectedCommand}" Margin="0,0,6,0"
                                          ToolTip="Sposta nel Cestino di Windows i file selezionati (Canc). Potrai ripristinarli dal Cestino." />
                        </WrapPanel>

                        <DataGrid x:Name="ProductFilesGrid" Grid.Row="3" ItemsSource="{Binding ProductFiles}"
                                  inf:GridKeys.DeleteCommand="{Binding RecycleSelectedCommand}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" RowHeight="32"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  SelectionChanged="ProductFilesGrid_SelectionChanged" MouseDoubleClick="FileGrid_MouseDoubleClick">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOld}" Value="True">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Versione" Binding="{Binding File.Version}" Width="110" MinWidth="82" ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="Stato" Width="140" MinWidth="105" SortMemberPath="State">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Visibility="{Binding State, Converter={x:Static inf:EmptyToCollapsedConverter.Instance}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOld}" Value="True">
                                                                <Setter Property="Background" Value="#FEF3C7" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding State}" FontSize="12" Foreground="#1F2937" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Nome" Binding="{Binding File.Name}" Width="2*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Architettura" Binding="{Binding File.ArchitectureText}" Width="115" MinWidth="86" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Firma" Binding="{Binding File.SignatureText}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Dimensione" Binding="{Binding File.Size, Converter={StaticResource FileSize}}" Width="95" MinWidth="71" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Cartella" Binding="{Binding File.Folder}" Width="2*" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Scheda Cloni e pulizia -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Duplicate}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Cloni e pulizia" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Ricerca -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SelectedSizeOption}" DisplayMemberPath="Label"
                                              MinWidth="170" Margin="12,0,10,0" ToolTip="Ignora i file più piccoli: la ricerca è più veloce e mostra solo ciò che pesa davvero" />
                                    <CheckBox Content="Anche cartelle di rete" IsChecked="{Binding IncludeNetworkInDuplicates}" Margin="0,0,12,0" VerticalAlignment="Center"
                                              ToolTip="I file in rete vanno letti attraverso la rete: la ricerca può essere molto più lenta" />
                                    <c:IconButton Glyph="{x:Static inf:Glyphs.Search}" Label="Cerca i cloni" Command="{Binding FindDuplicatesCommand}"
                                                  Style="{DynamicResource AccentButtonStyle}"
                                                  ToolTip="Trova i file con contenuto identico, anche se hanno nomi diversi o sono in cartelle diverse" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Duplicate}" Foreground="#7C3AED" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding DuplicatesSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <!-- Gruppi di file identici -->
                        <DataGrid x:Name="DuplicateGroupsGrid" Grid.Row="1" ItemsSource="{Binding DuplicateGroups}" SelectedItem="{Binding SelectedDuplicateGroup}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="32"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="File" Width="2*" MinWidth="200" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Duplicate}" Foreground="#7C3AED" Margin="2,0,10,0" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Copie" Binding="{Binding Files.Count}" Width="70" MinWidth="55" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Dimensione" Binding="{Binding Size, Converter={StaticResource FileSize}}" SortMemberPath="Size" Width="100" MinWidth="75" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Spazio recuperabile" Binding="{Binding WastedBytes, Converter={StaticResource FileSize}}" SortMemberPath="WastedBytes" Width="150" MinWidth="112" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Azioni -->
                        <WrapPanel Grid.Row="2" Margin="0,12,0,10">
                            <TextBlock Text="COPIE DEL FILE SELEZIONATO" Style="{StaticResource SectionHeader}" Margin="2,0,14,0" />
                            <ComboBox ItemsSource="{Binding KeepRules}" SelectedItem="{Binding SelectedKeepRule}" DisplayMemberPath="Label"
                                      MinWidth="260" Margin="0,0,6,0" ToolTip="Quale copia tenere in ogni gruppo" />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.SelectAll}" Label="Segna i doppioni" Command="{Binding MarkDoublesCommand}" Margin="0,0,6,0"
                                          ToolTip="In tutti i gruppi segna le copie da eliminare, tenendone una secondo la regola scelta" />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.Cancel}" Label="Togli i segni" Command="{Binding ClearMarksCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding MarkedSummary}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.Delete}" Label="Sposta nel Cestino" Command="{Binding RecycleMarkedCommand}" Margin="0,0,6,0"
                                          Style="{DynamicResource AccentButtonStyle}"
                                          ToolTip="Sposta nel Cestino di Windows le copie segnate. Resta sempre almeno una copia di ogni file." />
                            <c:IconButton Glyph="{x:Static inf:Glyphs.Move}" Label="Sposta in…" Command="{Binding MoveMarkedCommand}" Margin="0,0,6,0"
                                          ToolTip="Sposta le copie segnate in un'altra cartella (con anteprima e annullamento)" />
                        </WrapPanel>

                        <!-- Copie del gruppo selezionato -->
                        <DataGrid x:Name="DuplicateFilesGrid" Grid.Row="3" ItemsSource="{Binding DuplicateFiles}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" RowHeight="32"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  SelectionChanged="DuplicateFilesGrid_SelectionChanged" MouseDoubleClick="FileGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Da eliminare" Width="100" MinWidth="90" SortMemberPath="IsMarked">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsMarked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      ToolTip="Segna questa copia da spostare nel Cestino" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Stato" Width="110" MinWidth="90" SortMemberPath="State">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5E7EB" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKeeper}" Value="True">
                                                                <Setter Property="Background" Value="#DCFCE7" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding State}" FontSize="12" Foreground="#1F2937" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Nome" Binding="{Binding File.Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Modificato" Binding="{Binding File.ModifiedUtc, StringFormat=g, Converter={x:Static vm:UtcToLocalConverter.Instance}}"
                                                    SortMemberPath="File.ModifiedUtc" Width="130" MinWidth="97" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Cartella" Binding="{Binding File.Folder}" Width="2*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Schermata di benvenuto (nessuna cartella ancora) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="40"
                    Visibility="{Binding HasRoots, Converter={x:Static inf:InverseBoolToVisibilityConverter.Instance}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <Image Source="pack://application:,,,/PcOrg;component/Assets/pcorg.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Benvenuto in pcOrg" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"
                               Text="Scegli le cartelle da mettere in ordine — Download, Desktop, un disco esterno con installer e driver. pcOrg le analizza e divide i file per categoria, versione e produttore." />
                    <c:IconButton Glyph="{x:Static inf:Glyphs.Add}" Label="Aggiungi la prima cartella" Command="{Binding AddRootCommand}"
                                  Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,24,0,8" Padding="18,10" FontSize="14" />
                    <c:IconButton Glyph="{x:Static inf:Glyphs.Help}" Label="Leggi la guida" Command="{Binding ShowHelpCommand}"
                                  Style="{StaticResource SubtleIconButton}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="8">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Search}" FontSize="24" Foreground="#2563EB" HorizontalAlignment="Center" />
                            <TextBlock Text="Trova tutto all'istante" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,2" />
                            <TextBlock Text="Cerca per nome, cartella, prodotto o produttore." Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="8">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Package}" FontSize="24" Foreground="#7C3AED" HorizontalAlignment="Center" />
                            <TextBlock Text="Versioni e firme" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,2" />
                            <TextBlock Text="Scopri doppioni e versioni vecchie di programmi e driver." Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="8">
                            <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Undo}" FontSize="24" Foreground="#16A34A" HorizontalAlignment="Center" />
                            <TextBlock Text="Sempre reversibile" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,2" />
                            <TextBlock Text="Decidi tu cosa spostare; ogni spostamento si annulla." Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ Barra di stato -->
        <Border Grid.Row="3" Padding="18,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <c:IconButton DockPanel.Dock="Right" Glyph="{x:Static inf:Glyphs.Cancel}" Label="Interrompi" Command="{Binding CancelScanCommand}"
                              Padding="8,2" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Ferma la scansione: riprenderà al prossimo aggiornamento" />
                <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.Info}" FontSize="13" Margin="0,0,8,0" Opacity="0.7" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>

        <!-- ============================================================ Notifica a comparsa -->
        <Border Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,48"
                MinWidth="320" MaxWidth="520" Padding="14,12" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Background="{Binding ToastAccent}" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding ToastGlyph}" FontSize="14" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <c:IconButton DockPanel.Dock="Right" Glyph="{x:Static inf:Glyphs.Cancel}" Style="{StaticResource SubtleIconButton}"
                              Command="{Binding DismissToastCommand}" ToolTip="Chiudi" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{Binding ToastActionText}" Command="{Binding ToastActionCommand}"
                        Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource AccentButtonStyle}"
                        Visibility="{Binding ToastActionText, Converter={x:Static inf:EmptyToCollapsedConverter.Instance}}" />
                <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
