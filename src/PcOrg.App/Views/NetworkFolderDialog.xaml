<Window x:Class="PcOrg.App.Views.NetworkFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:PcOrg.App.Infrastructure"
        xmlns:c="clr-namespace:PcOrg.App.Controls"
        Title="Gestione File" Icon="pack://application:,,,/GestioneFile;component/Assets/pcorg.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,24,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="22" Background="#0891B2" VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock Style="{StaticResource Icon}" Text="{x:Static inf:Glyphs.NetworkFolder}" FontSize="20" Foreground="White"
                           HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Aggiungi una cartella di rete" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"
                           Text="Scrivi il percorso di una cartella condivisa su un NAS o su un altro computer, oppure sceglila con Sfoglia. Le unità di rete (es. Z:) vengono salvate con il loro percorso di rete." />
                <DockPanel>
                    <c:IconButton DockPanel.Dock="Right" Glyph="{x:Static inf:Glyphs.FolderOpen}" Label="Sfoglia…" Margin="8,0,0,0"
                                  Click="Browse_Click" ToolTip="Scegli la cartella da Rete o da un'unità di rete" />
                    <Grid>
                        <TextBox x:Name="PathBox" Padding="8,6" FontSize="14" TextChanged="PathBox_TextChanged" />
                        <TextBlock IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="\\NAS\Condivisa\Download">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PathBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource Secondary}"
                           Text="Se la cartella richiede nome utente e password, aprila prima da Esplora risorse ed effettua l'accesso: Gestione File userà lo stesso accesso. Quando la cartella non è raggiungibile i suoi file restano nell'elenco e vengono aggiornati appena torna disponibile." />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="24,14" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddButton" Content="Aggiungi" MinWidth="110" IsDefault="True" IsEnabled="False" Margin="0,0,8,0"
                        Style="{DynamicResource AccentButtonStyle}" Click="Add_Click" />
                <Button Content="Annulla" MinWidth="110" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
