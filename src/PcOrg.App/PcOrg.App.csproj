<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Permette di compilare anche da Linux/macOS (CI e sviluppo) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PcOrg</AssemblyName>
    <RootNamespace>PcOrg.App</RootNamespace>
    <Product>pcOrg</Product>
    <Version>0.12.0</Version>
    <NeutralLanguage>it-IT</NeutralLanguage>
    <!-- ThemeMode (tema Fluent) è ancora marcato come sperimentale -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\pcorg.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Pacchetti di distribuzione (dotnet publish -c Release -p:Pacchetto=...):
      Portatile (predefinito): cartella con PcOrg.exe e le librerie, .NET incluso, codice precompilato
                               (ReadyToRun). Nessuna estrazione all'avvio: è il più veloce e il più stabile.
      Leggero:                 cartella di pochi MB che usa il .NET 10 Desktop Runtime installato sul PC.
      FileUnico:               un solo PcOrg.exe compresso con tutto dentro (il più comodo, ma il più lento ad avviarsi):
                               all'avvio estrae la libreria del database in una cartella temporanea.
    Le impostazioni valgono solo in pubblicazione, così i test possono referenziare il progetto.
  -->
  <PropertyGroup>
    <Pacchetto Condition="'$(Pacchetto)' == ''">Portatile</Pacchetto>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(_IsPublishing)' == 'true' And '$(Pacchetto)' == 'Portatile'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(_IsPublishing)' == 'true' And '$(Pacchetto)' == 'Leggero'">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(_IsPublishing)' == 'true' And '$(Pacchetto)' == 'FileUnico'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\pcorg.ico" />
    <Resource Include="Assets\pcorg.png" />
    <!-- La guida (docs/GUIDA.md) viene incorporata nell'eseguibile -->
    <EmbeddedResource Include="..\..\docs\GUIDA.md" LogicalName="PcOrg.App.GUIDA.md" Link="GUIDA.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcOrg.Core\PcOrg.Core.csproj" />
  </ItemGroup>

</Project>
