<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Funzioni solo Windows (registro, SetupAPI, msi.dll, WinVerifyTrust, Cestino, unità di rete, priorità di I/O).
    PcOrg.Core le usa tramite IPlatformServices e resta portabile e testabile ovunque; l'app registra
    WindowsPlatform all'avvio.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PcOrg.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcOrg.Core\PcOrg.Core.csproj" />
  </ItemGroup>

</Project>
